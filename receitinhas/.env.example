# ───────── Obrigatório na Vercel ─────────
# Banco de dados Postgres. Na Vercel: Storage → Create Database → Neon (grátis). A variável é criada sozinha.
# No seu computador pode deixar vazio: o app usa um banco embutido salvo na pasta ./dados
DATABASE_URL=

# Texto longo e aleatório que protege o cookie de login (ex.: saída de `openssl rand -base64 48`).
SESSION_SECRET=

# Sua conta de administradora. É criada automaticamente na primeira vez que o site abre.
ADMIN_EMAIL=voce@email.com
ADMIN_SENHA=troque-esta-senha
ADMIN_NOME=Seu nome
