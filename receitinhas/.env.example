# ───────── IA do site (opcional) ─────────
# Chave da OpenAI usada quando a pessoa NÃO entra com o ChatGPT (ou o plano dela não libera uso).
# Crie em https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Modelo usado nas gerações (padrão: gpt-5-mini)
# OPENAI_MODEL=gpt-5-mini

# ───────── Login com ChatGPT (opcional) ─────────
# Client ID do app "Sign in with ChatGPT", fornecido pela OpenAI (começa com oaiapp_).
SIWC_CLIENT_ID=
# Endereço público do app, sem barra no final. O redirect registrado na OpenAI deve ser
# <APP_URL>/api/auth/chatgpt/callback
APP_URL=https://seu-app.vercel.app
# Texto longo e aleatório (ex.: saída de `openssl rand -base64 48`) que protege o cookie de sessão.
SESSION_SECRET=
# Avançado: só mude se a documentação da OpenAI que você receber indicar outros valores.
# SIWC_ISSUER=https://auth.openai.com
# SIWC_RESOURCE=https://api.openai.com/v1/responses
# SIWC_SCOPES=openid profile email offline_access resource.invoke chatgpt.tokens.use.direct

# ───────── receitinhas.html em outro site (opcional) ─────────
# Domínio do site que vai usar o receitinhas.html (ex.: https://meusite.com.br).
# Necessário para o login com ChatGPT funcionar a partir desse site.
# ALLOWED_ORIGIN=https://meusite.com.br
