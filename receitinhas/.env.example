# Chave da API da Anthropic (Claude) usada pelo gerador de cardápios.
# Crie a sua em https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: domínio do site que vai usar o receitinhas.html (ex.: https://meusite.com.br).
# Sem isso, qualquer site pode chamar a rota /api/gerar.
# ALLOWED_ORIGIN=https://meusite.com.br
